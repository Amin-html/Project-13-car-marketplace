# Build context: django_core/ (сам себе достаточен, соседние папки не нужны)
# Локально:  docker build -f django_core/Dockerfile.prod django_core/
# На Render: dockerContext "./django_core" + dockerfilePath "./django_core/Dockerfile.prod"

FROM python:3.13-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN python manage.py collectstatic --noinput

CMD python manage.py migrate --noinput && \
    gunicorn core.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 3
